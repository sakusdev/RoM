+        assert_eq!(
+            ferrum_nbt::decode_anonymous(disconnect_reader.take_remaining()).unwrap(),
+            Tag::String(
+                "Minecraft 26.1.2 requires the bundled minecraft/core/26.1.2 data pack".to_owned()
+            )
+        );
+        assert!(read_packet(&mut cursor).is_err());
+    }
